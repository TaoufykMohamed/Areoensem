# Serveur
NODE_ENV=development
PORT=5000

# Base de données (docker-compose fournit un Mongo local sur ce port)
MONGO_URI=mongodb://localhost:27017/aeroensem

# Authentification
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
COOKIE_NAME=aeroensem_token

# CORS — origine du frontend autorisée à envoyer des cookies
CLIENT_URL=http://localhost:5173

# Cloudinary (stockage des images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (candidatures, contact, confirmations d'inscription)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Club AéroENSEM <no-reply@aeroensem.ma>

# Compte admin créé par le script de seed
SEED_ADMIN_EMAIL=admin@aeroensem.ma
SEED_ADMIN_PASSWORD=change-me-in-production
